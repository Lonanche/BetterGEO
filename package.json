{
  "name": "bettergeo",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node build.mjs",
    "dev": "node build.mjs --watch",
    "test": "node --import tsx --test tests/*.test.ts",
    "format": "prettier --write src tests scripts build.mjs package.json tsconfig.json README.md .prettierrc.json",
    "format:check": "prettier --check src tests scripts build.mjs package.json tsconfig.json README.md .prettierrc.json",
    "pretest": "npm run build",
    "check:site": "node --import tsx scripts/check-site.ts"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "prettier": "3.6.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
